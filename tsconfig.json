{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "types": ["node", "./gateway/worker-configuration.d.ts"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "gateway/*.ts"]
}
