{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "digitalbrain-mcp-gateway",
  "main": "index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://digitalbrain-mcp-gateway.YOUR_SUBDOMAIN.workers.dev",
    "LAB_ORIGIN": "https://YOUR_LAB_DOMAIN"
  },
  "observability": {"enabled": false},
  "d1_databases": [{"binding":"DB","database_name":"digitalbrain-mcp-auth","database_id":"REPLACE_WITH_YOUR_D1_ID","migrations_dir":"migrations"}],
  "kv_namespaces": [{"binding":"OAUTH_KV","id":"REPLACE_WITH_YOUR_KV_ID"}],
  "ratelimits": [{"name":"REQUEST_LIMITER","namespace_id":"9182001","simple":{"limit":120,"period":60}}],
  "triggers": {"crons":["17 3 * * *"]}
}
